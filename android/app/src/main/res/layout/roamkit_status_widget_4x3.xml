<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F5F7FA"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#F5F7FA"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#A7ADB5"
            android:textSize="12sp"
            android:maxLines="2" />

        <LinearLayout
            android:id="@+id/widget_coverage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_coverage_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_view_coverage"
                android:textColor="#F5F7FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_globe"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/widget_view_coverage"
                android:src="@drawable/widget_ic_globe" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_center"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_remaining_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#DDFB55"
            android:textSize="13sp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F5F7FA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <LinearLayout
            android:id="@+id/widget_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_used"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="#7467F0"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_remaining_legend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#DDFB55"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
